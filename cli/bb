#!/usr/bin/env bash
# bb — Bitbucket Cloud CLI (gh-style wrapper around REST API v2)
set -euo pipefail

BB_VERSION="1.15.1"
BB_INSTALL_SOURCE="quatico-bb — brew install quatico-solutions/tap/quatico-bb"
# BB_API_URL lets the test suite redirect API calls to a local mock server.
# It is restricted to loopback so it can never be used to exfiltrate the
# auth token (sent as HTTP Basic on every call) to a remote host — there is
# no legitimate reason to point the Bitbucket Cloud CLI at a non-local host.
# Unset in production, where BB_API is the real Bitbucket API.
if [[ -n "${BB_API_URL:-}" ]]; then
  if [[ "$BB_API_URL" =~ ^https?://(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?(/|$) ]]; then
    BB_API="$BB_API_URL"
  else
    echo >&2 "error: BB_API_URL must point to a loopback host (localhost, 127.0.0.1, ::1)"
    exit 1
  fi
else
  BB_API="https://api.bitbucket.org/2.0"
fi

# --- Portability ------------------------------------------------------------

# `bb` stays inside the bash 3.2 feature set: macOS ships bash 3.2 and always will
# (bash 4 went GPLv3, which Apple does not ship), and `bb` runs on developer Macs.
# The bb-tests-macos CI job pins /bin/bash and runs the suite against it to keep it honest.
#
# Two differences bite in practice:
#
#   - No ${var^^} / ${var,,} case modification — use bb_upper below.
#   - Under `set -u`, bash 3.2 treats "${arr[@]}" on an EMPTY array as an unbound
#     variable and aborts; bash 4.4 fixed this. Where an array can legitimately be
#     empty, expand it as ${arr[@]+"${arr[@]}"}, which yields nothing on both.

# Not quite identical to ${1^^}: callers use "$(bb_upper "$x")", and command
# substitution strips trailing newlines. Only reachable via `--state $'open\n'` or
# `--method $'get\n'`, where dropping the newline is the repair — ${1^^} would have
# passed it through into a malformed request.
bb_upper() {
  printf '%s' "$1" | tr '[:lower:]' '[:upper:]'
}

# --- Auth -------------------------------------------------------------------

bb_token() {
  if [[ -n "${BB_TOKEN:-}" ]]; then
    echo "$BB_TOKEN"
    return
  fi
  local token
  token="$(security find-generic-password -s "com.quatico.bitbucket-cli" -a "token" -w 2>/dev/null)" || {
    echo >&2 "error: no Bitbucket API token found — run: bb auth login, or export BB_TOKEN=<token>"
    exit 1
  }
  echo "$token"
}

bb_email() {
  if [[ -n "${BB_EMAIL:-}" ]]; then
    echo "$BB_EMAIL"
    return
  fi
  security find-generic-password -s "com.quatico.bitbucket-cli" -a "email" -w 2>/dev/null || {
    echo >&2 "error: no email found — run: bb auth login"
    exit 1
  }
}

# --- Repo detection ----------------------------------------------------------

bb_parse_remote() {
  local url
  url="$(git remote get-url origin 2>/dev/null)" || {
    echo >&2 "error: not a git repository or no 'origin' remote"
    exit 1
  }
  # SSH:  git@ssh.bitbucket.org:workspace/repo.git (git@bitbucket.org: before 2026-11-12)
  # HTTPS: https://bitbucket.org/workspace/repo.git
  if [[ "$url" != *bitbucket.org* ]]; then
    echo >&2 "error: origin remote is not a bitbucket.org URL: $url"
    echo >&2 "  Use -R workspace/repo to specify the repository"
    exit 1
  fi
  local path
  path="$(echo "$url" | sed -E 's#^(git@(ssh\.)?bitbucket\.org:|ssh://git@((ssh|altssh)\.)?bitbucket\.org(:[0-9]+)?/|https://([^@/]*@)?bitbucket\.org/)##; s/\.git$//')"
  echo "$path"
}

bb_workspace() {
  if [[ -n "${_BB_WORKSPACE:-}" ]]; then
    echo "$_BB_WORKSPACE"
  else
    bb_parse_remote | cut -d/ -f1
  fi
}

bb_repo() {
  if [[ -n "${_BB_REPO:-}" ]]; then
    echo "$_BB_REPO"
  else
    bb_parse_remote | cut -d/ -f2
  fi
}

# --- Unicode helpers ---------------------------------------------------------

bb_nfc() {
  # Normalize Unicode string to NFC (composed form).
  # macOS terminals emit NFD (decomposed: a + combining ¨); Bitbucket API returns NFC (ä).
  # Without normalization, byte-level == in jq fails on names like "Bänziger".
  perl -CSA -MUnicode::Normalize -e 'print NFC(join(" ", @ARGV))' -- "$@"
}

# --- User resolution ---------------------------------------------------------

bb_resolve_user() {
  # Resolve a reviewer identifier to a JSON object for the reviewers array.
  # Returns {account_id} or {uuid}. Accepts: UUID ({...}), account_id (24-char hex or realm:uuid), or display name.
  local input="$1"

  # UUID — use directly
  if [[ "$input" == \{*\} ]]; then
    jq -n --arg uuid "$input" '{"uuid": $uuid}'
    return
  fi

  # Account ID — 24-char hex (legacy) or Atlassian realm:uuid (modern, e.g. 557058:<uuid>)
  if [[ "$input" =~ ^[0-9a-f]{24}$ || "$input" =~ ^[0-9]+:[0-9a-f-]{36}$ ]]; then
    jq -n --arg id "$input" '{"account_id": $id}'
    return
  fi

  # Display name — search PR participants in the current repo
  input="$(bb_nfc "$input")"
  local ws repo
  ws="$(bb_workspace)"
  repo="$(bb_repo)"
  local prs account_id rc
  prs="$(bb_paginate "/repositories/${ws}/${repo}/pullrequests?state=MERGED" 50)" || { rc=$?; [[ "$rc" -eq 75 ]] && return 75; prs="[]"; }
  account_id="$(echo "$prs" | jq -r --arg name "$input" '
    [.[] | (.author, .reviewers[]?) |
     select(.display_name == $name or .nickname == $name) |
     .account_id] | first // empty')"

  if [[ -z "$account_id" ]]; then
    # Also search open PRs
    prs="$(bb_paginate "/repositories/${ws}/${repo}/pullrequests?state=OPEN" 50)" || { rc=$?; [[ "$rc" -eq 75 ]] && return 75; prs="[]"; }
    account_id="$(echo "$prs" | jq -r --arg name "$input" '
      [.[] | (.author, .reviewers[]?) |
       select(.display_name == $name or .nickname == $name) |
       .account_id] | first // empty')"
  fi

  if [[ -z "$account_id" ]]; then
    echo >&2 "error: cannot resolve reviewer '$input'"
    echo >&2 "  Use account_id (24-char hex or realm:uuid) or UUID ({...}) directly"
    echo >&2 "  Or check: bb -R $ws/$repo pr list --state merged --json | jq '.[].reviewers[].display_name'"
    return 1
  fi

  jq -n --arg id "$account_id" '{"account_id": $id}'
}

# --- HTTP core ---------------------------------------------------------------

# One-line message for "no HTTP answer". $1 is the file holding curl's stderr:
# its first line names the cause (DNS, TLS, connect) and goes in parentheses,
# without the "curl: (N) " prefix. curl's own line never reaches the terminal.
bb_no_response_message() {
  local reason=""
  [[ -n "${1:-}" && -s "$1" ]] && reason="$(head -n 1 "$1" | sed -E 's/^curl: (\([0-9]+\) )?//')"
  if [[ -n "$reason" ]]; then
    printf 'error: no response from Bitbucket (%s)' "$reason"
  else
    printf 'error: no response from Bitbucket'
  fi
}

# Only a 2xx answer is success. curl writes 000 when no response arrives, and
# 1xx/3xx never carry the data the caller asked for. Prints the error and
# returns 1 on anything else; $2 is the response body for the message. HTTP 429
# returns 75 (EX_TEMPFAIL) so a caller can tell "wait and retry" from "fix the
# call": it starts the pause (bb_pause_after_429), which stops every bb process
# of the account, and says when bb sends again. $4 is the file that holds the
# response headers, for Retry-After; it is optional. The message says "rate
# limited" and never the number, because Plot reads a 429 in stderr as a short
# burst, not a spent quota.
bb_check_status() {
  local http_code="$1" body="${2:-}" err_file="${3:-}" hdr_file="${4:-}"
  [[ "$http_code" =~ ^2[0-9][0-9]$ ]] && return 0
  if [[ "$http_code" == "000" ]]; then
    echo >&2 "$(bb_no_response_message "$err_file")"
    return 1
  fi
  if [[ "$http_code" == "429" ]]; then
    local message
    message="$(bb_pause_after_429 "${BB_ACCOUNT_KEY:-}" "$(bb_retry_after "$hdr_file")")"
    echo >&2 "error: rate limited — ${message}"
    return 75
  fi
  local msg
  msg="$(echo "$body" | jq -r '.error.message // .error // "unknown error"' 2>/dev/null)" || msg="$body"
  echo >&2 "error: HTTP $http_code — $msg"
  return 1
}

# --- Request budget ----------------------------------------------------------

# bb keeps an hourly request budget per account and per machine. It records the
# time of every request it sends, a request that Bitbucket answers with 429
# included, and refuses the next one while the last 3600 s hold BB_HOURLY_LIMIT
# requests. The default is 800; 0 turns the ceiling off and still records.
#
# After an HTTP 429, bb also pauses: every bb process of the account on this
# machine refuses to send until the pause has ended, so a second process cannot
# keep a rate limit alive. The pause is the first check of the guard, and the
# ceiling may be off while it applies.
#
# The state is plain files in one directory and has no lock. Calls that start
# in the same second can pass a ceiling together, and the ceiling is a guard
# against a runaway loop, not an exact meter. A state directory that cannot be
# used never blocks a call: bb warns once and sends.

BB_BUDGET_DEFAULT=800
BB_BUDGET_WINDOW=3600
# The longest pause a Retry-After can ask for, in seconds: a day.
BB_RETRY_AFTER_MAX=86400
# Seconds by which a pause may end later than its length before it counts as stale; it absorbs clock readings a few seconds apart between parallel processes.
BB_PAUSE_SKEW=5
# Per process, never from the environment: the account key once it is read and
# the email it was made from, whether the state warning was printed, whether
# bb_budget_init found the state directory unusable, and whether it found an
# existing state directory that every user can write to.
BB_ACCOUNT_KEY=""
BB_ACCOUNT_EMAIL=""
BB_STATE_WARNED=""
BB_STATE_OFF=""
BB_STATE_WORLD_WRITABLE=""
# How this system's date reads an epoch, found once per process from $OSTYPE
# without running a command: BSD date (macOS, the BSDs) takes -r <epoch>, GNU
# date takes -d @<epoch>. On GNU date, -r names a file.
case "${OSTYPE:-}" in
  darwin*|*bsd*) BB_DATE_FLAVOUR=bsd ;;
  *)             BB_DATE_FLAVOUR=gnu ;;
esac

# Epoch seconds. BB_NOW replaces the clock for the test suite, and only while
# BB_API_URL is set: that variable already limits bb to a loopback host.
bb_now() {
  if [[ -n "${BB_API_URL:-}" && "${BB_NOW:-}" =~ ^[0-9]+$ ]]; then
    echo "$BB_NOW"
  else
    date +%s
  fi
}

# $1 is an epoch second, $2 a date format. A BSD system also falls back to -d @,
# for GNU date ahead of the system one in PATH; a GNU system never tries -r, which
# would read the file of that name.
bb_date_utc() {
  if [[ "$BB_DATE_FLAVOUR" == bsd ]]; then
    date -u -r "$1" "+$2" 2>/dev/null || date -u -d "@$1" "+$2"
  else
    date -u -d "@$1" "+$2"
  fi
}

# Prints "<stamp> <previous>": the UTC hour stamps (YYYYMMDDHH) of the second $1
# and of the second 3600 s before it, which name the request files that the guard
# reads. One date call; the previous hour is stamp - 1 except in the first hour of
# a day, where it takes a second call.
bb_hour_stamps() {
  local now="$1" stamp prev
  stamp="$(bb_date_utc "$now" %Y%m%d%H)" || return 1
  [[ "$stamp" =~ ^[0-9]{10}$ ]] || return 1
  if [[ "${stamp:8:2}" == 00 ]]; then
    prev="$(bb_date_utc "$((now - BB_BUDGET_WINDOW))" %Y%m%d%H)" || return 1
    [[ "$prev" =~ ^[0-9]{10}$ ]] || return 1
  else
    prev=$((10#$stamp - 1))
  fi
  printf '%s %s\n' "$stamp" "$prev"
}

# HH:MM:SSZ in UTC.
bb_utc_hms() {
  bb_date_utc "$1" '%H:%M:%SZ'
}

# A wait of exactly 429 s is shown as 430 s: Plot reads "429" in stderr as an
# HTTP 429, and a wait is not a status code.
bb_shown_wait() {
  if [[ "$1" -eq 429 ]]; then echo 430; else echo "$1"; fi
}

# The state directory, without touching the file system. An empty variable
# counts as unset. Returns 1 when no variable gives a path.
bb_state_path() {
  if [[ -n "${BB_STATE_DIR:-}" ]]; then
    printf '%s\n' "$BB_STATE_DIR"
  elif [[ -n "${XDG_STATE_HOME:-}" ]]; then
    printf '%s\n' "${XDG_STATE_HOME}/bb"
  elif [[ -n "${HOME:-}" ]]; then
    printf '%s\n' "${HOME}/.local/state/bb"
  else
    return 1
  fi
}

# Succeeds when any user can write to the directory $1. find -H follows a symlink
# named on the command line, so it reads the mode of the target and not the one of
# the link (Linux gives every symlink mode 777). A directory that find cannot read
# counts as writable. It starts a process, so it runs once, in bb_budget_init.
bb_state_world_writable() {
  local dir="$1" found
  case "$dir" in /*) ;; *) dir="./${dir}" ;; esac
  found="$(find -H "$dir" -maxdepth 0 -perm -0002 2>/dev/null)" || return 0
  [[ -n "$found" ]]
}

# The state directory. A missing one is created with mode 700. One that exists is
# used when the effective user owns it, it takes files, and bb_budget_init did not
# find it writable by every user (BB_STATE_WORLD_WRITABLE): in a directory that
# another user owns or that every user can write to, that user can plant a pause
# file or a request log, and a root bb that keeps HOME would create files that
# belong to root in the user's directory. A directory that only the group can
# write stays accepted, because a user-private group and umask 002 make those on
# Linux. bb never changes the mode of a directory that exists, because the person
# may name any directory. Returns 1 when there is no path or the directory cannot
# be used. Calls that start together may all create it: mkdir -p succeeds on a
# directory that exists.
bb_state_dir() {
  local dir
  dir="$(bb_state_path)" || return 1
  if [[ -d "$dir" ]]; then
    [[ -O "$dir" && -w "$dir" && -x "$dir" && -z "${BB_STATE_WORLD_WRITABLE:-}" ]] || return 1
  else
    mkdir -p -m 700 "$dir" 2>/dev/null || return 1
  fi
  printf '%s\n' "$dir"
}

# One warning per process (BB_STATE_WARNED) when the budget cannot be kept.
# Callers return 0 afterwards, so the request goes out.
bb_state_warn() {
  [[ -n "${BB_STATE_WARNED:-}" ]] && return 0
  BB_STATE_WARNED=1
  local where
  where="$(bb_state_path)" || where='~/.local/state/bb'
  echo >&2 "warning: bb cannot keep its request count in ${where}; the hourly budget is off for this call"
}

# The first 12 hex characters of the SHA-256 of the lowercased email; the
# default email is the account bb uses. It names the account in file names.
bb_account_key() {
  local email sum
  if [[ $# -gt 0 ]]; then
    email="$1"
  else
    email="$(bb_email)" || return 1
  fi
  # LC_ALL=C: tr lowercases ASCII only, in every locale, so one account has one
  # key. Plot's fleetd shares the ledger and lowercases ASCII only too.
  # sha256sum first: shasum is a perl script on macOS and starts slowly.
  if command -v sha256sum >/dev/null 2>&1; then
    sum="$(printf '%s' "$email" | LC_ALL=C tr '[:upper:]' '[:lower:]' | sha256sum)" || return 1
  elif command -v shasum >/dev/null 2>&1; then
    sum="$(printf '%s' "$email" | LC_ALL=C tr '[:upper:]' '[:lower:]' | shasum -a 256)" || return 1
  else
    return 1
  fi
  printf '%s\n' "${sum:0:12}"
}

# The ceiling: BB_HOURLY_LIMIT, else 800. A whole number; 0 turns it off. A
# value with more than 9 digits counts as 999999999, which no hour reaches.
bb_hourly_limit() {
  local value="${BB_HOURLY_LIMIT:-$BB_BUDGET_DEFAULT}"
  if [[ ! "$value" =~ ^[0-9]+$ ]]; then
    echo >&2 "error: BB_HOURLY_LIMIT must be a whole number, got '${value}'"
    exit 1
  fi
  value="${value#"${value%%[!0]*}"}"
  [[ -z "$value" ]] && value=0
  [[ "${#value}" -gt 9 ]] && value=999999999
  echo "$value"
}

# Prints "<n> <free>" for the account's request files. n counts the lines
# newer than $1 - 3600 and not newer than $1 in $3 (the previous hour) and $4
# (the current hour); lines that are not all digits do not count, and neither
# does a line from the future, so no line can make a wait longer than 3600 s.
# free is the second at which the request ceiling $2 lets the next request
# through: the (n - c + 1)-th oldest counted line plus 3600, or 0 while n is
# below the ceiling. A file that is missing holds no request. A file that exists
# and cannot be read (no read permission, not a regular file) makes the count
# unknown: the function prints nothing and returns 1, and the caller warns.
bb_budget_count() {
  local now="$1" limit="$2" prev_file="$3" cur_file="$4" file
  for file in "$prev_file" "$cur_file"; do
    if [[ -e "$file" ]] && { [[ ! -f "$file" ]] || [[ ! -r "$file" ]]; }; then
      return 1
    fi
  done
  { cat "$prev_file" "$cur_file" 2>/dev/null || true; } | awk -v now="$now" -v min="$((now - BB_BUDGET_WINDOW))" -v c="$limit" -v window="$BB_BUDGET_WINDOW" '
    /^[0-9]+$/ && length($0) <= 12 && $0 + 0 > min && $0 + 0 <= now { v[++n] = $0 + 0 }
    END {
      for (i = 2; i <= n; i++) {
        x = v[i]; j = i - 1
        while (j >= 1 && v[j] > x) { v[j + 1] = v[j]; j-- }
        v[j + 1] = x
      }
      free = 0
      if (n >= c) free = v[n - c + 1] + window
      print n + 0, free
    }'
}

# Deletes the request files of every account that are older than the previous
# UTC hour ($2, YYYYMMDDHH). Best effort: a file that stays does no harm.
bb_budget_prune() {
  local dir="$1" keep_from="$2" file stamp
  for file in "$dir"/requests-*-*.log; do
    [[ -f "$file" ]] || continue
    stamp="${file%.log}"
    stamp="${stamp##*-}"
    if [[ "$stamp" =~ ^[0-9]{10}$ && "$stamp" < "$keep_from" ]]; then
      rm -f "$file" 2>/dev/null || true
    fi
  done
  return 0
}

# The Retry-After value of the last response in the header file $1, as sent, or
# nothing. curl -D writes the headers of every response of a redirect chain; a
# status line starts a new response, so only the last one counts.
bb_retry_after() {
  [[ -n "${1:-}" && -f "$1" ]] || return 0
  tr -d '\r' < "$1" | awk '
    /^HTTP\// { v = "" }
    tolower(substr($0, 1, 12)) == "retry-after:" { v = substr($0, 13); gsub(/^[ \t]+|[ \t]+$/, "", v) }
    END { print v }'
}

# Prints "<until> <length>" from the pause file of the account $1: the second at
# which the pause ends and its length in seconds. Prints nothing when the file is
# missing or does not hold exactly two whole numbers of at most 12 digits, leading
# zeros not counted, the length above 0 (bb never writes a pause of 0 s); an
# unreadable pause file is no pause.
bb_pause_read() {
  [[ -n "${1:-}" ]] || return 0
  local dir pause_end="" pause_len="" rest=""
  dir="$(bb_state_path)" || return 0
  { read -r pause_end pause_len rest < "${dir}/pause-${1}"; } 2>/dev/null || true
  if [[ "$pause_end" =~ ^[0-9]+$ && "$pause_len" =~ ^[0-9]+$ && -z "$rest" ]]; then
    pause_end="${pause_end#"${pause_end%%[!0]*}"}"
    pause_len="${pause_len#"${pause_len%%[!0]*}"}"
    if [[ "${#pause_end}" -le 12 && "${#pause_len}" -le 12 ]]; then
      pause_end="${pause_end:-0}"
      pause_len="${pause_len:-0}"
      [[ "$pause_len" -gt 0 ]] && printf '%s %s\n' "$pause_end" "$pause_len"
    fi
  fi
  return 0
}

# Succeeds when the pause "<until> <length>" ($1, $2) is stale at the second $3:
# it has more than BB_PAUSE_SKEW s more time left than its length. bb writes every
# pause with the invariant "end - now <= length" (see bb_pause_after_429), and
# time only shortens the rest, so such a pause was written by a clock that ran
# ahead of this one by more than the skew, or was edited by hand. A stale pause
# counts as no pause, for the guard, for bb rate-limit and for the next 429, so
# that no call waits for a day.
bb_pause_is_stale() {
  [[ "$1" -gt "$3" && $(($1 - $3)) -gt $(($2 + BB_PAUSE_SKEW)) ]]
}

# Prints the seconds left of the pause of the account $1, or nothing when there
# is none, it has ended or it is stale. $2 is the second to measure from; the
# default is now.
bb_pause_left() {
  local now="${2:-}" stored pause_end pause_len
  [[ -n "$now" ]] || now="$(bb_now)"
  stored="$(bb_pause_read "$1")"
  [[ -n "$stored" ]] || return 0
  pause_end="${stored% *}"
  pause_len="${stored#* }"
  if [[ "$pause_end" -gt "$now" ]] && ! bb_pause_is_stale "$pause_end" "$pause_len" "$now"; then
    echo "$((pause_end - now))"
  fi
  return 0
}

# Stores "<until> <length>" ($2, $3) as the pause of the account $1 and prints
# what it stored, "<until> <length>". $4 is the second to measure from; the
# default is now. The line goes to a temporary file in the same directory and is
# moved into place, so a reader never sees half a line. Returns 1, and prints
# nothing, when that fails.
#
# There is no lock, so the write merges with the pause on disk instead. Just
# before the move it reads the stored pause again; when that pause is not stale
# and ends later than the one to write, the record keeps the later end and the
# larger length ("end - now <= length" still holds, within BB_PAUSE_SKEW, at the
# clock of the process that stored the longer pause), so a process that computed
# its pause from an older read cannot shorten a longer pause that another one
# stored meanwhile. The remaining window is the time between that read and the
# move, the fork of mv: a process that moves its record into place in that
# window is overwritten, and its pause is lost. The next 429 starts the pause
# again, so the loss costs one more refused request, not a block.
bb_pause_write() {
  local dir tmp now="${4:-}" end="$2" len="$3" stored stored_end stored_len
  [[ -n "$now" ]] || now="$(bb_now)"
  dir="$(bb_state_path)" || return 1
  tmp="$(mktemp "${dir}/pause-${1}.XXXXXX" 2>/dev/null)" || return 1
  stored="$(bb_pause_read "$1")"
  if [[ -n "$stored" ]]; then
    stored_end="${stored% *}"
    stored_len="${stored#* }"
    if [[ "$stored_end" -gt "$end" ]] && ! bb_pause_is_stale "$stored_end" "$stored_len" "$now"; then
      end="$stored_end"
      [[ "$stored_len" -gt "$len" ]] && len="$stored_len"
    fi
  fi
  if { printf '%s %s\n' "$end" "$len" > "$tmp"; } 2>/dev/null && mv -f "$tmp" "${dir}/pause-${1}" 2>/dev/null; then
    printf '%s %s\n' "$end" "$len"
    return 0
  fi
  rm -f "$tmp" 2>/dev/null || true
  return 1
}

# Starts or extends the pause of the account $1 after an HTTP 429 and prints the
# tail of the message: "bb paused until HH:MM:SSZ (in N s)", with "Bitbucket
# asked to wait <ra> s; " in front when $2 is a Retry-After of digits, which is
# printed as sent. Any other $2 is no Retry-After. The rule, for the pause stored
# before this 429, where a stale pause (bb_pause_is_stale) counts as none:
#   none, or ended 3600 s ago or longer:  length 300 s
#   ended less than 3600 s ago:  length twice the stored one, at most 3600 s
#   in both cases the length is at least Retry-After, and the end is now + length;
#   a Retry-After above BB_RETRY_AFTER_MAX (a day), or with more than 9 digits,
#   leading zeros not counted, counts as BB_RETRY_AFTER_MAX
#   still active:  the end is the later of the stored end and now + Retry-After
#                  (300 s without one); the length is the larger of the stored
#                  length and the new end - now
# Several processes that get a 429 together leave one pause, not a doubled one.
# Every pause written keeps the invariant "end - now <= length" at write time.
# bb_pause_write keeps a longer pause that another process stored after the read
# above, and the tail names the end that stayed.
# A pause that cannot be stored (no key, no state directory, a write that fails)
# gives the warning of bb_state_warn; the tail still names the pause bb would
# have stored, and the caller exits 75 all the same.
bb_pause_after_429() {
  local key="${1:-}" raw="${2:-}"
  local ra="" now stored="" stored_end=0 stored_len=0 new_end new_len shown message
  if [[ "$raw" =~ ^[0-9]+$ ]]; then
    # Leading zeros do not count towards the 9 digits; raw stays as sent. The
    # length is tested first, so a longer value never reaches the arithmetic.
    ra="${raw#"${raw%%[!0]*}"}"
    [[ -z "$ra" ]] && ra=0
    if [[ "${#ra}" -gt 9 || "$ra" -gt "$BB_RETRY_AFTER_MAX" ]]; then
      ra="$BB_RETRY_AFTER_MAX"
    fi
  fi
  now="$(bb_now)"
  stored="$(bb_pause_read "$key")"
  if [[ -n "$stored" ]]; then
    stored_end="${stored% *}"
    stored_len="${stored#* }"
    if bb_pause_is_stale "$stored_end" "$stored_len" "$now"; then
      stored=""
    fi
  fi

  if [[ -n "$stored" && "$now" -lt "$stored_end" ]]; then
    new_end=$((now + ${ra:-300}))
    [[ "$stored_end" -gt "$new_end" ]] && new_end="$stored_end"
    new_len="$stored_len"
    [[ $((new_end - now)) -gt "$new_len" ]] && new_len=$((new_end - now))
  else
    if [[ -n "$stored" && $((now - stored_end)) -lt 3600 ]]; then
      new_len=$((stored_len * 2))
      [[ "$new_len" -gt 3600 ]] && new_len=3600
    else
      new_len=300
    fi
    [[ -n "$ra" && "$ra" -gt "$new_len" ]] && new_len="$ra"
    new_end=$((now + new_len))
  fi

  # The write may find a longer pause on disk and keep it; the tail names the
  # end that was stored.
  local written=""
  if [[ -n "$key" ]] && written="$(bb_pause_write "$key" "$new_end" "$new_len" "$now")"; then
    new_end="${written% *}"
  else
    bb_state_warn
  fi

  shown="$(bb_shown_wait "$((new_end - now))")"
  message="bb paused until $(bb_utc_hms "$((now + shown))") (in ${shown} s)"
  [[ -n "$ra" ]] && message="Bitbucket asked to wait ${raw} s; ${message}"
  printf '%s\n' "$message"
}

# Runs once in the main shell, with the command line as $@, before the command
# is dispatched. It validates BB_HOURLY_LIMIT, which exits 1 on an invalid value
# before any temporary file or request, and it makes the state directory. An
# existing state directory is checked here, once, for a mode that every user can
# write (BB_STATE_WORLD_WRITABLE), which bb_state_dir reads: the check starts a
# process, and bb_state_dir runs for every request. A state directory that cannot
# be used gives the warning here, once, and sets BB_STATE_OFF, which the request
# subshells inherit and bb_request_guard reads.
# Help and a bare `bb` skip the limit, the directory and the warning: they send no
# request, and they must work whatever the settings are. They still run the
# world-writable check, on a directory that exists, because an argument that reads
# --help can be the value of a flag, as in `pr comment 1 --body --help`, and the
# command then sends requests that bb_state_dir must refuse for such a directory.
bb_budget_init() {
  local arg help=""
  if [[ "${1:-help}" == "help" ]]; then
    help=1
  fi
  for arg in "$@"; do
    if [[ "$arg" == "--help" || "$arg" == "-h" ]]; then
      help=1
    fi
  done
  if [[ -z "$help" ]]; then
    bb_hourly_limit > /dev/null
  fi
  local dir
  if dir="$(bb_state_path)" && [[ -d "$dir" ]]; then
    if bb_state_world_writable "$dir"; then
      BB_STATE_WORLD_WRITABLE=1
    fi
  fi
  if [[ -n "$help" ]]; then
    return 0
  fi
  if ! bb_state_dir > /dev/null; then
    BB_STATE_OFF=1
    bb_state_warn
  fi
  return 0
}

# Runs before every request bb sends; $1 is the account's email. Returns 0 to
# send, after it has recorded the request, or prints the refusal and returns
# 75: first the pause that a 429 started, then the ceiling. A refused request is
# not recorded. An invalid BB_HOURLY_LIMIT exits 1. State that cannot be kept
# gives one warning and returns 0; when bb_budget_init has found the state
# unusable, it returns 0 at once and says nothing.
bb_request_guard() {
  [[ -n "${BB_STATE_OFF:-}" ]] && return 0
  local email="${1:-}"
  local limit dir now stamps stamp prev_stamp cur_file prev_file left
  limit="$(bb_hourly_limit)" || exit 1
  dir="$(bb_state_dir)" || { bb_state_warn; return 0; }
  # The key is made once per email: a call for another email makes its own.
  if [[ -z "${BB_ACCOUNT_KEY:-}" || "${BB_ACCOUNT_EMAIL:-}" != "$email" ]]; then
    BB_ACCOUNT_KEY="$(bb_account_key "$email")" || { bb_state_warn; return 0; }
    BB_ACCOUNT_EMAIL="$email"
  fi
  now="$(bb_now)"

  left="$(bb_pause_left "$BB_ACCOUNT_KEY" "$now")"
  if [[ -n "$left" ]]; then
    left="$(bb_shown_wait "$left")"
    echo >&2 "error: rate limited — bb paused until $(bb_utc_hms "$((now + left))") after Bitbucket refused a request (in ${left} s)"
    return 75
  fi

  stamps="$(bb_hour_stamps "$now")" || { bb_state_warn; return 0; }
  stamp="${stamps% *}"
  prev_stamp="${stamps#* }"
  cur_file="${dir}/requests-${BB_ACCOUNT_KEY}-${stamp}.log"
  prev_file="${dir}/requests-${BB_ACCOUNT_KEY}-${prev_stamp}.log"

  if [[ "$limit" -gt 0 ]]; then
    local counted n free wait_s
    # A count that cannot be made is no count: warn and send.
    counted="$(bb_budget_count "$now" "$limit" "$prev_file" "$cur_file")" || { bb_state_warn; return 0; }
    n="${counted%% *}"
    free="${counted##* }"
    [[ "$n" =~ ^[0-9]+$ && "$free" =~ ^[0-9]+$ ]] || { bb_state_warn; return 0; }
    if [[ "$n" -ge "$limit" ]]; then
      wait_s=$((free - now))
      [[ "$wait_s" -lt 1 ]] && wait_s=1
      wait_s="$(bb_shown_wait "$wait_s")"
      echo >&2 "error: rate limited — ${n} requests in the last hour from this machine; next request at $(bb_utc_hms "$((now + wait_s))") (in ${wait_s} s)"
      return 75
    fi
  fi

  { printf '%s\n' "$now" >> "$cur_file"; } 2>/dev/null || { bb_state_warn; return 0; }
  bb_budget_prune "$dir" "$prev_stamp"
  return 0
}

bb_api_call() {
  local method="$1" path="$2"; shift 2
  local token email
  token="$(bb_token)" || exit 1
  email="$(bb_email)" || exit 1
  bb_request_guard "$email" || return $?
  local response http_code err_file hdr_file
  err_file="$(mktemp)"
  hdr_file="$(mktemp)"
  response="$(curl -sSL -D "$hdr_file" -w "\n%{http_code}" -X "$method" \
    -u "${email}:${token}" \
    -H "Content-Type: application/json" \
    -H "Accept: application/json" \
    "$@" \
    "${BB_API}${path}" 2>"$err_file")" || true
  http_code="$(echo "$response" | tail -1)"
  local body rc=0
  body="$(echo "$response" | sed '$d')"

  bb_check_status "$http_code" "$body" "$err_file" "$hdr_file" || rc=$?
  rm -f "$err_file" "$hdr_file"
  [[ "$rc" -eq 0 ]] || return "$rc"
  echo "$body"
}

# Follow Bitbucket's `next` links until `limit` rows are held or `next` is
# empty. A limit of 0 means no row limit. The page size is the caller's
# business: it belongs in $path, because the maximum differs per endpoint.
#
# HTTP 429 on a page stops the listing at once: bb starts the pause
# (bb_pause_after_429), prints `error: rate limited after <n> rows — ` and the
# tail of the pause, returns 75, and prints NO rows — a short list must never
# look complete. A retry would only spend requests that the pause refuses.
# Every other non-2xx fails on the first attempt too.
#
# This runs inside $(…), so it cannot hand its caller a second value on stdout.
# When BB_PAGINATE_NEXT_FILE names a file, it holds "1" afterwards if a `next`
# link was left when the loop stopped, and is empty otherwise.
bb_paginate() {
  local path="$1"; shift
  local limit="${1:-50}"
  # Pages accumulate in a file, one JSON array per line: a growing array passed
  # through `jq --argjson` overflows the argument-size limit at a few thousand rows.
  local rows=0 acc_file
  local url="${BB_API}${path}"
  local token email
  token="$(bb_token)" || exit 1
  email="$(bb_email)" || exit 1
  local hdr_file err_file
  hdr_file="$(mktemp)"
  acc_file="$(mktemp)"
  err_file="$(mktemp)"
  [[ -n "${BB_PAGINATE_NEXT_FILE:-}" ]] && : > "$BB_PAGINATE_NEXT_FILE"

  while [[ -n "$url" ]]; do
    local response http_code body guard_rc
    bb_request_guard "$email" || { guard_rc=$?; rm -f "$hdr_file" "$acc_file" "$err_file"; return "$guard_rc"; }
    response="$(curl -sSL -D "$hdr_file" -w "\n%{http_code}" -X GET \
      -u "${email}:${token}" \
      -H "Accept: application/json" \
      "$url" 2>"$err_file")" || true
    http_code="$(echo "$response" | tail -1)"
    body="$(echo "$response" | sed '$d')"

    if ! [[ "$http_code" =~ ^2[0-9][0-9]$ ]]; then
      if [[ "$http_code" == "429" ]]; then
        local message
        message="$(bb_pause_after_429 "${BB_ACCOUNT_KEY:-}" "$(bb_retry_after "$hdr_file")")"
        rm -f "$hdr_file" "$acc_file" "$err_file"
        echo >&2 "error: rate limited after ${rows} rows — ${message}"
        return 75
      fi
      bb_check_status "$http_code" "$body" "$err_file" || true
      rm -f "$hdr_file" "$acc_file" "$err_file"
      return 1
    fi

    local page_rows
    page_rows="$(echo "$body" | jq -c '.values // []' | tee -a "$acc_file" | jq 'length')"
    rows=$((rows + page_rows))
    url="$(echo "$body" | jq -r '.next // empty')"

    [[ "$limit" -gt 0 && "$rows" -ge "$limit" ]] && break
  done
  local all
  all="$(jq -s --argjson l "$limit" 'add // [] | if $l > 0 then .[:$l] else . end' "$acc_file")"
  rm -f "$hdr_file" "$acc_file" "$err_file"
  # Rows were left behind: a `next` link remains, or the last page held more
  # rows than the limit keeps.
  [[ -n "${BB_PAGINATE_NEXT_FILE:-}" && ( -n "$url" || ( "$limit" -gt 0 && "$rows" -gt "$limit" ) ) ]] \
    && echo 1 > "$BB_PAGINATE_NEXT_FILE"
  echo "$all"
}

# Read a whole listing at the endpoint's page size of 100. A limit of 0 reads
# every page; a positive limit stops there and, when rows were left behind,
# prints one line on stderr. $path must not carry a query string.
bb_paginate_listing() {
  local path="$1" limit="$2"
  local next_file result rc=0
  next_file="$(mktemp)"
  result="$(BB_PAGINATE_NEXT_FILE="$next_file" bb_paginate "${path}?pagelen=100" "$limit")" || rc=$?
  if [[ "$rc" -eq 0 && -s "$next_file" ]]; then
    echo >&2 "warning: listing truncated at ${limit} rows; use a larger --limit"
  fi
  rm -f "$next_file"
  [[ "$rc" -eq 0 ]] || return "$rc"
  echo "$result"
}

# Validate a --limit value: a positive whole number.
bb_check_limit() {
  if [[ ! "$1" =~ ^[0-9]+$ || "$1" -eq 0 ]]; then
    echo >&2 "error: --limit must be a positive number, got '$1'"
    exit 1
  fi
}

bb_api_raw() {
  local path="$1"; shift
  local token email
  token="$(bb_token)" || exit 1
  email="$(bb_email)" || exit 1
  bb_request_guard "$email" || return $?
  local response http_code err_file hdr_file
  err_file="$(mktemp)"
  hdr_file="$(mktemp)"
  response="$(curl -sSL -D "$hdr_file" -w "\n%{http_code}" -X GET \
    -u "${email}:${token}" \
    "$@" \
    "${BB_API}${path}" 2>"$err_file")" || true
  http_code="$(echo "$response" | tail -1)"
  local body rc=0
  body="$(echo "$response" | sed '$d')"
  bb_check_status "$http_code" "$body" "$err_file" "$hdr_file" || rc=$?
  rm -f "$err_file" "$hdr_file"
  [[ "$rc" -eq 0 ]] || return "$rc"
  printf '%s' "$body"
}

bb_current_ref() {
  local ws repo
  ws="$(bb_workspace)"
  repo="$(bb_repo)"
  bb_api_call GET "/repositories/${ws}/${repo}" | jq -r '.mainbranch.name // "main"'
}

bb_read_body_file() {
  # Read PR/comment body text from a file path, or stdin when path is "-".
  # Mirrors gh's --body-file on `pr create`, `pr edit` and `pr comment`.
  local file="$1"
  if [[ "$file" == "-" ]]; then
    cat
  else
    if [[ ! -f "$file" ]]; then
      echo >&2 "error: body file not found: $file"
      exit 1
    fi
    cat "$file"
  fi
}

bb_download_upload() {
  # Upload a file to the repo Downloads area via multipart/form-data.
  # bb_api_call can't do this: it always sends Content-Type: application/json,
  # but downloads require multipart. We let curl build the multipart body (and
  # its boundary) via -F. A successful upload returns HTTP 201 with no body.
  # Files collide by name in Downloads — a re-upload with the same name
  # overwrites the previous one.
  local ws="$1" repo="$2" file="$3" name="$4"
  local token email
  token="$(bb_token)" || exit 1
  email="$(bb_email)" || exit 1
  bb_request_guard "$email" || return $?
  local response http_code body err_file hdr_file rc=0
  err_file="$(mktemp)"
  hdr_file="$(mktemp)"
  response="$(curl -sSL -D "$hdr_file" -w "\n%{http_code}" -X POST \
    -u "${email}:${token}" \
    -F "files=@${file};filename=${name}" \
    "${BB_API}/repositories/${ws}/${repo}/downloads" 2>"$err_file")" || true
  http_code="$(echo "$response" | tail -1)"
  body="$(echo "$response" | sed '$d')"
  bb_check_status "$http_code" "$body" "$err_file" "$hdr_file" || rc=$?
  rm -f "$err_file" "$hdr_file"
  [[ "$rc" -eq 0 ]] || return "$rc"
}

# --- Output formatting -------------------------------------------------------

bb_format_pr_list() {
  jq -r '.[] | [
    (.id | tostring),
    (if .draft == true then "DRAFT" else (.state // "OPEN") end),
    (.author.display_name // .author.nickname // "unknown"),
    (.source.branch.name // "?"),
    (.title // "(no title)")
  ] | @tsv' | column -t -s $'\t'
}

bb_format_pr_view() {
  jq -r '
    "Title:    " + (.title // "(no title)"),
    "State:    " + (if .draft == true then "DRAFT" else (.state // "?") end),
    "Author:   " + (.author.display_name // .author.nickname // "?"),
    "Source:   " + (.source.branch.name // "?"),
    "Dest:     " + (.destination.branch.name // "?"),
    "Created:  " + (.created_on // "?"),
    "Updated:  " + (.updated_on // "?"),
    "URL:      " + (.links.html.href // "?"),
    "",
    "Reviewers:",
    ((.reviewers // []) | if length == 0 then "  (none)" else .[] | "  - " + (.display_name // .nickname // "?") end),
    "",
    "---",
    "",
    (.description // "(no description)")'
}

# Rewrites fence-marker text to "... (escaped)". Shared by every formatter that renders
# third-party text, so the marker vocabulary is defined once — two copies of a
# security-relevant regex drift, and the one that drifts is the one nobody re-reads.
# Case-insensitive and whitespace-tolerant, so "--  END   untrusted content --" is caught.
BB_JQ_FENCE_ESCAPE='
  def fence_escape:
    tostring
    | gsub("--\\s*(?<k>begin|end)\\s+untrusted\\s+content";
           "-- " + (.k | ascii_downcase) + " untrusted content (escaped)"; "i");
'

bb_format_comment_list() {
  jq -r "$BB_JQ_FENCE_ESCAPE"'.[] | [
    (.id | tostring),
    (.user.display_name // .user.nickname // "unknown" | fence_escape),
    (.created_on | split("T")[0] // "?"),
    (if .inline then "inline:" + (.inline.path // "?" | fence_escape) + ":" + ((.inline.to // .inline.from // 0) | tostring) else "general" end),
    (.content.raw // "(empty)" | fence_escape | gsub("\n"; " ") | .[:80])
  ] | @tsv' | column -t -s $'\t'
}

# Random hex token used to make the untrusted-content fence unforgeable. Regenerated per
# invocation, so a token that leaks (e.g. an agent pastes bb output back into a comment)
# is worthless by the time anyone could use it.
bb_fence_token() {
  od -An -N4 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n' \
    || printf '%04x%04x' "$RANDOM" "$RANDOM"
}

# Full comment bodies, each fenced as untrusted content. Comment text is written by
# third parties: the markers make that boundary explicit in the output itself, so a
# reader (human or agent) can see where quoted data starts and stops without having to
# remember a rule. Bodies are NOT truncated here — a reviewer acting on feedback needs
# the whole text, and truncating would also hide the tail of an injected instruction.
#
# The markers carry a per-invocation token because a fixed delimiter is not a boundary:
# a comment author who knows it can simply close the fence and have the rest of their
# text render as if it were bb's own output. Two guards, with different reach:
#
#   1. fence_escape rewrites marker text to "... (escaped)". It is case-insensitive and
#      tolerates whitespace variants, so "--  END   untrusted content --" is caught too.
#      It is still a text match: it will not catch a lookalike built from en-dashes or
#      separated by zero-width characters.
#   2. The real markers carry a token the author could not have known. This is the guard
#      that holds unconditionally — a closer without this run's token is not a closer,
#      however convincing it looks — and it is what covers guard 1's blind spots.
#
# Guard 1 exists so ordinary quoting of a marker is visibly defused rather than relying on
# the reader checking hex; guard 2 is the actual boundary. A legitimate comment quoting a
# marker renders with "(escaped)" appended — mildly noisy, and the safe direction.
#
# EVERY third-party field goes through this, not just the body. display_name, nickname and
# inline.path are attacker-controlled too, and they sit on the header line ABOVE the
# opening marker: a newline in a git path — which git permits — would otherwise place
# arbitrary text outside every fence, and a forged display_name could reattribute one
# comment's body to another author. Header fields are additionally flattened to one line.
bb_format_comment_bodies() {
  local token
  token="$(bb_fence_token)"
  jq -r --arg t "$token" "$BB_JQ_FENCE_ESCAPE"'
    # Header fields are identity, not content, so unlike bodies they are capped: a forged
    # display name should not be able to ride a page of fake output in on the header line.
    def header_field: fence_escape | gsub("\\s*[\\r\\n]+\\s*"; " ") | .[:80];
    .[] |
    "-- comment " + (.id | tostring) +
    " by " + ((.user.display_name // .user.nickname // "unknown") | header_field) +
    (if .inline then " on " + ((.inline.path // "?") | header_field) + ":" + ((.inline.to // .inline.from // 0) | tostring) else "" end) +
    " -- begin untrusted content " + $t + " --\n" +
    ((.content.raw // "(empty)") | fence_escape) +
    "\n-- end untrusted content " + $t + " --\n"'
}

bb_format_diffstat() {
  jq -r '.[] | [
    .status,
    ("+" + (.lines_added | tostring)),
    ("-" + (.lines_removed | tostring)),
    (.new.path // .old.path // "?")
  ] | @tsv' | column -t -s $'\t'
}

# True when a NEWLINE-delimited list already contains an entry. Used to keep
# repeated flags idempotent: `--state open --state open` is one state, not two.
#
# Newlines rather than spaces because an --author value is a display name and
# may contain spaces ("Alice Smith"): splitting those on whitespace turns one
# author into two that do not exist.
bb_str_contains_line() {
  local haystack="$1" needle="$2" line
  local IFS=$'\n'
  for line in ${haystack:-}; do
    [[ "$line" == "$needle" ]] && return 0
  done
  return 1
}

# Build the pull-request query for a set of states and authors.
#
# This is the ONE place the state filter is constructed. There are two shapes —
# `state=` parameters, and a `q=` filter expression when an author is involved —
# and Bitbucket lets **q= silently override state=** when both appear. Measured:
# `?q=state="OPEN"&state=MERGED` returns OPEN only, with no complaint.
#
# So a caller must never append `state=` alongside a `q=`: it looks like it
# works, and quietly discards every state. Deciding that here, once, is the
# point of this function — three inline constructions were free to drift, and
# the drift is invisible until someone combines --author with two states.
bb_pr_list_query() {
  local states="$1" authors="$2" since="${3:-}" heads="${4:-}"
  local s a h expr ors path
  local IFS=$'\n'

  if [[ -z "$authors" && -z "$since" && -z "$heads" ]]; then
    # No author: repeated state= parameters. Bitbucket returns the union,
    # already sorted descending by updated_on — one call, nothing to re-sort.
    path=""
    for s in $states; do
      path="${path}${path:+&}state=${s}"
    done
    printf '?%s' "$path"
    return 0
  fi

  # An author, a head branch or an --updated-since bound forces the q= form,
  # so the states must travel inside it too.
  ors=""
  for s in $states; do
    ors="${ors:+$ors OR }state = \"${s}\""
  done
  expr="(${ors})"

  if [[ -n "$heads" ]]; then
    ors=""
    for h in $heads; do
      ors="${ors:+$ors OR }source.branch.name = \"${h}\""
    done
    expr="${expr} AND (${ors})"
  fi

  if [[ -n "$authors" ]]; then
    ors=""
    for a in $authors; do
      ors="${ors:+$ors OR }author.nickname = \"${a}\""
    done
    expr="${expr} AND (${ors})"
  fi

  # Inclusive: a caller that reads again from its last watermark gets the PR
  # at the boundary twice, never zero times.
  if [[ -n "$since" ]]; then
    expr="${expr} AND updated_on >= \"${since}\""
  fi

  printf '?q=%s' "$(printf '%s' "$expr" | jq -sRr @uri)"
}

# Map a comma-separated list of gh-style field names to a jq program that
# projects each PR object into an object with exactly those keys (gh semantics:
# `--json a,b` -> [{"a":…,"b":…},…]). Field names mirror `gh pr list --json`;
# values are read from the Bitbucket API v2 paths. Prints an error naming the
# supported fields and returns 1 on any unknown field. Kept subcommand-agnostic
# so other `pr` subcommands can reuse it later.
bb_pr_json_projection() {
  local fields="$1" frag out="" f
  local -a list
  # Reject empty field names (leading/trailing/double comma). Checked on the raw
  # string because `read` silently drops a trailing empty segment.
  if [[ "$fields" == ,* || "$fields" == *, || "$fields" == *,,* ]]; then
    echo >&2 "error: empty field name in list '$fields'"
    return 1
  fi
  IFS=',' read -ra list <<< "$fields"
  # `list` is empty when $fields is empty; expand empty-safely rather than aborting.
  for f in ${list[@]+"${list[@]}"}; do
    case "$f" in
      number)      frag="number: .id" ;;
      title)       frag="title: .title" ;;
      state)       frag="state: .state" ;;
      headRefName) frag="headRefName: .source.branch.name" ;;
      baseRefName) frag="baseRefName: .destination.branch.name" ;;
      isDraft)     frag="isDraft: .draft" ;;
      author)      frag="author: {login: .author.nickname}" ;;
      url)         frag="url: .links.html.href" ;;
      createdAt)   frag="createdAt: .created_on" ;;
      updatedAt)   frag="updatedAt: .updated_on" ;;
      # Not a path into the PR object: bb_pr_attach_checks has already merged a
      # `checks` key onto each PR (see bb_pr_needs_checks). Project it through.
      checks)      frag="checks: .checks" ;;
      *)
        echo >&2 "error: unknown field '$f' (supported: number, title, state, headRefName, baseRefName, isDraft, author, url, createdAt, updatedAt, checks)"
        return 1 ;;
    esac
    out="${out:+$out, }$frag"
  done
  printf '[.[] | { %s }]' "$out"
}

# True when a --json field list asks for a field that cannot be projected from
# the PR object and must be fetched separately. Keeps the extra API calls
# opt-in: a caller asking for `number,headRefName` pays nothing.
bb_pr_needs_checks() {
  local fields="$1" f
  local -a list
  IFS=',' read -ra list <<< "$fields"
  for f in ${list[@]+"${list[@]}"}; do
    [[ "$f" == "checks" ]] && return 0
  done
  return 1
}

# Collapse a commit's build statuses to one answer, in Bitbucket's own
# vocabulary. Reads the /statuses response on stdin; prints one word.
#
# One red check means the set is not green, so a failure outranks anything
# still running — the only judgement bb makes here, and it must not depend on
# the order the API happened to list the statuses in.
#
# NONE and UNKNOWN are deliberately different answers. An empty `values` on a
# successful call means no build ever ran (a fact about the repository); a call
# that failed means the builds could not be read (a fact about this call). An
# implementation that reports NONE on error passes every positive test while
# announcing a clearance it never received.
bb_pr_collapse_statuses() {
  jq -r '
    [.values[]?.state] as $s
    | if   ($s | length) == 0            then "NONE"
      elif ($s | any(. == "FAILED" or . == "STOPPED")) then
        ($s | map(select(. == "FAILED" or . == "STOPPED")) | first)
      elif ($s | any(. == "INPROGRESS")) then "INPROGRESS"
      elif ($s | all(. == "SUCCESSFUL")) then "SUCCESSFUL"
      else "UNKNOWN" end
  ' 2>/dev/null || echo "UNKNOWN"
}

# Merge a `checks` key onto every PR in the list on stdin, one /statuses call
# per PR. The head SHA comes from the PR object itself (source.commit.hash),
# so no lookup is needed to find the commit.
#
# A PR whose statuses cannot be read gets UNKNOWN and the command carries on —
# one unreadable PR must not fail a list of twenty. A rate limit is the one
# exception: it stops the whole command with 75 and the call's own rate-limit
# line on stderr, because every later call would be refused too. A partial list
# of checks must not be printed as complete.
bb_pr_attach_checks() {
  local ws="$1" repo="$2"
  local prs sha checks_val i count out err_file rc
  prs="$(cat)"
  count="$(echo "$prs" | jq 'length')"

  if [[ "$count" -gt 20 ]]; then
    echo >&2 "note: reading build statuses for $count pull requests ($count extra API calls)"
  fi

  out="$prs"
  err_file="$(mktemp)"
  i=0
  while [[ "$i" -lt "$count" ]]; do
    sha="$(echo "$prs" | jq -r ".[$i].source.commit.hash // empty")"
    if [[ -z "$sha" ]]; then
      # No head SHA on the PR object: the builds cannot be located, which is an
      # unreadable answer rather than an absent one.
      checks_val="UNKNOWN"
    else
      local body
      # The call's stderr goes to a file, so that only a rate limit reaches the
      # terminal: any other failure stays silent and gives UNKNOWN.
      rc=0
      body="$(bb_api_call GET "/repositories/${ws}/${repo}/commit/${sha}/statuses" 2>"$err_file")" || rc=$?
      if [[ "$rc" -eq 75 ]]; then
        cat "$err_file" >&2
        rm -f "$err_file"
        return 75
      elif [[ "$rc" -eq 0 ]]; then
        checks_val="$(echo "$body" | bb_pr_collapse_statuses)"
      else
        checks_val="UNKNOWN"
      fi
    fi
    out="$(echo "$out" | jq --argjson i "$i" --arg c "$checks_val" '.[$i] += {checks: $c}')"
    i=$((i + 1))
  done
  rm -f "$err_file"
  echo "$out"
}

